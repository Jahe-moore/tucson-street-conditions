<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_as-is" targetNamespace="https://example.org/tucson-streets">
  <bpmn:collaboration id="Collab_as-is">
    <bpmn:participant id="Pool_as-is" name="As-is today (assumed, to confirm with staff)" processRef="Proc_as-is" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_as-is" isExecutable="false">
    <bpmn:laneSet id="Lanes_as-is">
      <bpmn:lane id="Lane_Ward" name="Ward council office">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TDOT" name="TDOT pavement and GIS staff">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Util" name="Utility crew and permit desk">
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Constituent asks about a street"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="T1" name="Email TDOT for the ward's street conditions"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T2" name="Export pavement layer to Excel"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T3" name="Filter rows to the ward by hand"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T4" name="Email spreadsheet back"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T5" name="Answer constituent from the spreadsheet"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E1" name="Answered, days later"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Crew plans a street cut"><bpmn:outgoing>F7</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="T6" name="Request a street cut permit"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T7" name="Permit desk looks up last repave date by hand"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Repaved in last 5 years?"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T8" name="Add moratorium restoration rules"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T9" name="Issue permit"><bpmn:incoming>F11</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E2" name="Permit issued"><bpmn:incoming>F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="E1" />
    <bpmn:sequenceFlow id="F7" sourceRef="S2" targetRef="T6" />
    <bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F9" sourceRef="T7" targetRef="G1" />
    <bpmn:sequenceFlow id="F10" name="Yes" sourceRef="G1" targetRef="T8" />
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F12" name="No" sourceRef="G1" targetRef="T9" />
    <bpmn:sequenceFlow id="F13" sourceRef="T9" targetRef="E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_as-is"><bpmndi:BPMNPlane id="Plane_as-is" bpmnElement="Collab_as-is">
    <bpmndi:BPMNShape id="Pool_as-is_di" bpmnElement="Pool_as-is" isHorizontal="true"><dc:Bounds x="150" y="80" width="1060" height="480" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Ward_di" bpmnElement="Lane_Ward" isHorizontal="true"><dc:Bounds x="180" y="80" width="1030" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_TDOT_di" bpmnElement="Lane_TDOT" isHorizontal="true"><dc:Bounds x="180" y="240" width="1030" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Util_di" bpmnElement="Lane_Util" isHorizontal="true"><dc:Bounds x="180" y="400" width="1030" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="220" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="214" y="182" width="70" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="290" y="120" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="450" y="280" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="610" y="280" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="770" y="280" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="990" y="120" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1130" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1103" y="182" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S2_di" bpmnElement="S2"><dc:Bounds x="220" y="462" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="214" y="502" width="70" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="290" y="440" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="450" y="440" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="615" y="455" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="595" y="423" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="720" y="440" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T9_di" bpmnElement="T9"><dc:Bounds x="880" y="440" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="1040" y="462" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1013" y="502" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="256" y="160" /><di:waypoint x="290" y="160" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="350" y="200" /><di:waypoint x="350" y="320" /><di:waypoint x="450" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="570" y="320" /><di:waypoint x="610" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="730" y="320" /><di:waypoint x="770" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="890" y="320" /><di:waypoint x="1050" y="320" /><di:waypoint x="1050" y="200" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1110" y="160" /><di:waypoint x="1130" y="160" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="256" y="480" /><di:waypoint x="290" y="480" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="410" y="480" /><di:waypoint x="450" y="480" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="570" y="480" /><di:waypoint x="615" y="480" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="665" y="480" /><di:waypoint x="720" y="480" /><bpmndi:BPMNLabel><dc:Bounds x="671" y="484" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="840" y="480" /><di:waypoint x="880" y="480" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="640" y="505" /><di:waypoint x="640" y="545" /><di:waypoint x="940" y="545" /><di:waypoint x="940" y="520" /><bpmndi:BPMNLabel><dc:Bounds x="646" y="509" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1000" y="480" /><di:waypoint x="1040" y="480" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
