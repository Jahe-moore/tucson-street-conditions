<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_to-be" targetNamespace="https://example.org/tucson-streets">
  <bpmn:collaboration id="Collab_to-be">
    <bpmn:participant id="Pool_to-be" name="To-be: one nightly load answers every question" processRef="Proc_to-be" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_to-be" isExecutable="false">
    <bpmn:laneSet id="Lanes_to-be">
      <bpmn:lane id="Lane_Ward" name="Ward council office">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TDOT" name="TDOT pavement and GIS staff">
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Util" name="Utility crew and permit desk">
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Resident calls"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T1" name="Open ward report (shows only own ward)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E1" name="Answered same day"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="S3" name="Nightly 2:15 AM"><bpmn:outgoing>F3</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_S3" /></bpmn:startEvent>
    <bpmn:serviceTask id="T2" name="Pull city layers from ArcGIS REST"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T3" name="Stage and merge into SQL Server"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T4" name="Run data quality checks"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Any error checks?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="GIS fixes the source data"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E3" name="Report data refreshed"><bpmn:incoming>F8</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Crew plans a street cut"><bpmn:outgoing>F10</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T6" name="Look up segment in the dig-check view"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Under moratorium?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="Apply restoration rules"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T8" name="Issue permit"><bpmn:incoming>F13</bpmn:incoming><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E2" name="Permit issued"><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="E1" />
    <bpmn:sequenceFlow id="F3" sourceRef="S3" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" name="Yes" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="E3" />
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="G2" targetRef="E3" />
    <bpmn:sequenceFlow id="F10" sourceRef="S2" targetRef="T6" />
    <bpmn:sequenceFlow id="F11" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="F12" name="Yes" sourceRef="G3" targetRef="T7" />
    <bpmn:sequenceFlow id="F13" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="G3" targetRef="T8" />
    <bpmn:sequenceFlow id="F15" sourceRef="T8" targetRef="E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_to-be"><bpmndi:BPMNPlane id="Plane_to-be" bpmnElement="Collab_to-be">
    <bpmndi:BPMNShape id="Pool_to-be_di" bpmnElement="Pool_to-be" isHorizontal="true"><dc:Bounds x="150" y="80" width="1000" height="480" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Ward_di" bpmnElement="Lane_Ward" isHorizontal="true"><dc:Bounds x="180" y="80" width="970" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_TDOT_di" bpmnElement="Lane_TDOT" isHorizontal="true"><dc:Bounds x="180" y="240" width="970" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Util_di" bpmnElement="Lane_Util" isHorizontal="true"><dc:Bounds x="180" y="400" width="970" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="220" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="208" y="182" width="60" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="290" y="120" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="450" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="423" y="182" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S3_di" bpmnElement="S3"><dc:Bounds x="220" y="302" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="214" y="342" width="70" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="290" y="280" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="450" y="280" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="610" y="280" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="770" y="295" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="750" y="263" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="870" y="280" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E3_di" bpmnElement="E3"><dc:Bounds x="1050" y="302" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1030" y="262" width="76" height="34" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S2_di" bpmnElement="S2"><dc:Bounds x="220" y="462" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="214" y="502" width="70" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="290" y="440" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="450" y="455" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="430" y="423" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="550" y="440" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="710" y="440" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="870" y="462" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="843" y="502" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="256" y="160" /><di:waypoint x="290" y="160" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="410" y="160" /><di:waypoint x="450" y="160" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="256" y="320" /><di:waypoint x="290" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="410" y="320" /><di:waypoint x="450" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="570" y="320" /><di:waypoint x="610" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="730" y="320" /><di:waypoint x="770" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="820" y="320" /><di:waypoint x="870" y="320" /><bpmndi:BPMNLabel><dc:Bounds x="826" y="324" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="990" y="320" /><di:waypoint x="1050" y="320" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="795" y="345" /><di:waypoint x="795" y="385" /><di:waypoint x="1068" y="385" /><di:waypoint x="1068" y="338" /><bpmndi:BPMNLabel><dc:Bounds x="801" y="349" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="256" y="480" /><di:waypoint x="290" y="480" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="410" y="480" /><di:waypoint x="450" y="480" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="500" y="480" /><di:waypoint x="550" y="480" /><bpmndi:BPMNLabel><dc:Bounds x="506" y="484" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="670" y="480" /><di:waypoint x="710" y="480" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="475" y="505" /><di:waypoint x="475" y="545" /><di:waypoint x="770" y="545" /><di:waypoint x="770" y="520" /><bpmndi:BPMNLabel><dc:Bounds x="481" y="509" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="830" y="480" /><di:waypoint x="870" y="480" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
