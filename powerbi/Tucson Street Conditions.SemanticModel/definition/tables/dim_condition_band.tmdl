table dim_condition_band

	column band_id
		dataType: int64
		summarizeBy: none
		sourceColumn: band_id
		isHidden

	column band
		dataType: string
		summarizeBy: none
		sourceColumn: band
		sortByColumn: band_id

	column min_oci
		dataType: double
		summarizeBy: none
		sourceColumn: min_oci

	column max_oci
		dataType: double
		summarizeBy: none
		sourceColumn: max_oci

	partition dim_condition_band = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost\SQLEXPRESS", "TucsonStreets"),
				    Data = Source{[Schema="rpt",Item="dim_condition_band"]}[Data]
				in
				    Data
