table v_quality

	column check_name
		dataType: string
		summarizeBy: none
		sourceColumn: check_name

	column severity
		dataType: string
		summarizeBy: none
		sourceColumn: severity

	column row_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: row_count

	column detail
		dataType: string
		summarizeBy: none
		sourceColumn: detail

	column checked_at
		dataType: dateTime
		formatString: mmm d, yyyy h:mm AM/PM
		summarizeBy: none
		sourceColumn: checked_at

	partition v_quality = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost\SQLEXPRESS", "TucsonStreets"),
				    Data = Source{[Schema="rpt",Item="v_quality"]}[Data]
				in
				    Data
